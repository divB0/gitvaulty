{
  "name": "gitvaulty",
  "displayName": "GitVaulty",
  "description": "Edit GitVaulty encrypted files in VS Code's native text editor.",
  "version": "3.0.2",
  "publisher": "divb0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "assets/icon.png",
  "pricing": "Free",
  "categories": [
    "Other"
  ],
  "keywords": [
    "secrets",
    "encryption",
    "sops",
    "age",
    "dotenv",
    "environment",
    "git",
    "security"
  ],
  "galleryBanner": {
    "color": "#101827",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/divB0/gitvaulty.git"
  },
  "homepage": "https://github.com/divB0/gitvaulty/tree/main/vscode",
  "bugs": {
    "url": "https://github.com/divB0/gitvaulty/issues"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "GitVaulty decrypts repository secrets and requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "GitVaulty requires local Git, filesystem, identity, and SOPS access."
    }
  },
  "activationEvents": [
    "onCustomEditor:gitvaulty.editor",
    "onFileSystem:gitvaulty"
  ],
  "main": "./dist/extension.js",
  "files": [
    "assets/icon.png",
    "bin/**",
    "dist/extension.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "gitvaulty.editor",
        "displayName": "GitVaulty",
        "selector": [
          {
            "filenamePattern": "*.gitvaulty"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "gitvaulty.copyEncryptedPath",
        "title": "GitVaulty: Copy Encrypted File Path"
      },
      {
        "command": "gitvaulty.reload",
        "title": "GitVaulty: Reload Encrypted Version"
      },
      {
        "command": "gitvaulty.showAccess",
        "title": "GitVaulty: Show File Access"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitvaulty.showAccess",
          "group": "navigation",
          "when": "resourceScheme == gitvaulty"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "npm run typecheck && npm test && npm run test:integration",
    "check:package": "vsce ls --tree",
    "package": "vsce package",
    "package:local": "node scripts/package-local.mjs",
    "stage:sops": "node scripts/stage-sops.mjs",
    "test": "vitest run",
    "test:integration": "npm run build && node esbuild.test.mjs && node dist/test/runTest.cjs",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "optionalDependencies": {
    "@clef-sh/sops-darwin-arm64": "3.12.2",
    "@clef-sh/sops-darwin-x64": "3.12.2",
    "@clef-sh/sops-linux-arm64": "3.12.2",
    "@clef-sh/sops-linux-x64": "3.12.2",
    "@clef-sh/sops-win32-x64": "3.12.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
