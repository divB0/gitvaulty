{
  "name": "gitvaulty-vscode",
  "displayName": "GitVaulty",
  "description": "Edit GitVaulty encrypted files in VS Code's native text editor.",
  "version": "0.1.0",
  "publisher": "divB0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCustomEditor:gitvaulty.editor",
    "onFileSystem:gitvaulty"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "gitvaulty.editor",
        "displayName": "GitVaulty",
        "selector": [
          {
            "filenamePattern": "*.gitvaulty"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "gitvaulty.copyEncryptedPath",
        "title": "GitVaulty: Copy Encrypted File Path"
      },
      {
        "command": "gitvaulty.reload",
        "title": "GitVaulty: Reload Encrypted Version"
      },
      {
        "command": "gitvaulty.showAccess",
        "title": "GitVaulty: Show File Access"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gitvaulty.showAccess",
          "group": "navigation",
          "when": "resourceScheme == gitvaulty"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "npm run typecheck && npm test && npm run test:integration",
    "test": "vitest run",
    "test:integration": "npm run build && node esbuild.test.mjs && node dist/test/runTest.cjs",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@clef-sh/sops-darwin-arm64": "3.12.2",
    "@clef-sh/sops-darwin-x64": "3.12.2",
    "@clef-sh/sops-linux-arm64": "3.12.2",
    "@clef-sh/sops-linux-x64": "3.12.2",
    "@clef-sh/sops-win32-x64": "3.12.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
