{
  "name": "gitvaulty",
  "version": "0.2.0",
  "description": "Git-backed secrets for humans.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divB0/gitvaulty.git"
  },
  "homepage": "https://github.com/divB0/gitvaulty#readme",
  "bugs": "https://github.com/divB0/gitvaulty/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "secrets",
    "git",
    "sops",
    "age",
    "dotenv",
    "terraform"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gitvaulty": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "age-encryption": "0.3.0",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6"
  },
  "optionalDependencies": {
    "@clef-sh/sops-darwin-arm64": "3.12.2",
    "@clef-sh/sops-darwin-x64": "3.12.2",
    "@clef-sh/sops-linux-arm64": "3.12.2",
    "@clef-sh/sops-linux-x64": "3.12.2",
    "@clef-sh/sops-win32-x64": "3.12.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.2.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
